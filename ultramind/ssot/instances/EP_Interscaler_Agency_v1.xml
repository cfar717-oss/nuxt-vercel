<EvidencePack ep_id="EP-2025-12-16-INTERSCALER-PROOF" version="1.0.0" status="draft">
  <ClaimPolicy claim_boundary="moderate">
    <HardRules>
      <Rule>no_fake_case_studies</Rule>
      <Rule>no_unverified_income_claims</Rule>

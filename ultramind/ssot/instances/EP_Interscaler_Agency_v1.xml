      <Text>Clients report reduced manual follow-up and clearer pipeline visibility after implementation.</Text>
      <EvidenceRefs><Ref>E20</Ref><Ref>E21</Ref><Ref>E22</Ref></EvidenceRefs>
      <UsageGuidance>Frame as testimonials / client-reported outcomes.</UsageGuidance>
    </Claim>

    <Claim id="C03" confidence="strong">
      <Text>We provide documented milestones, weekly deliverables, and handoff documentation as part of delivery.</Text>
      <EvidenceRefs><Ref>E03</Ref></EvidenceRefs>
      <UsageGuidance>This is a process claim—safe if true operationally.</UsageGuidance>
    </Claim>
  </ApprovedClaims>

